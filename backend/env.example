# Database Configuration
# Format: postgresql://username:password@host:port/database_name
# Local:  postgresql://postgres:your_password@localhost:5432/ctrack_db
# Neon:   postgresql://neondb_owner:your_password@ep-xxx.eu-central-1.aws.neon.tech/ctrack_db?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ctrack_db

# API Configuration
API_V1_PREFIX=/api
PROJECT_NAME=CTrack API
DEBUG=True

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Authentication
# Generate a secure secret key using: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Background jobs (seconds) — keep above 300 so Neon can scale to zero between runs
DEADLINE_CHECK_INTERVAL_SECONDS=1800
INFERENCE_INTERVAL_SECONDS=1800

# AI chat (ColaAssist)
GEMINI_API_KEY=
