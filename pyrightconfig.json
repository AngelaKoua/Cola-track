{
  "venvPath": "backend",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "include": [
    "backend",
    "data-science"
  ],
  "exclude": [
    "_archive",
    "**/node_modules",
    "**/__pycache__"
  ],
  "extraPaths": [
    "backend"
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none"
}
